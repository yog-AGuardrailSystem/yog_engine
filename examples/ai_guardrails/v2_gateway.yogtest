{
  "policy": "v2_gateway.yog",
  "tests": [
    {"name": "a read inside the workspace is allowed, with its obligations",
     "request": {"actor": "bot", "action": "run_tool", "resource": "read_file",
                 "args": {"input": {"path": "/workspace/notes.txt"}}, "env": {"stage": "dev", "context_tainted": false}},
     "expect": {"decision": "ALLOW", "obligations": ["audit", "rate_limit", "max_output_bytes"]}},
    {"name": "a read outside the workspace is denied",
     "request": {"actor": "bot", "action": "run_tool", "resource": "read_file",
                 "args": {"input": {"path": "/etc/passwd"}}, "env": {"stage": "dev", "context_tainted": false}},
     "expect": {"decision": "DENY", "reason_contains": "deny clause", "obligations": []}},
    {"name": "DROP TABLE is denied",
     "request": {"actor": "bot", "action": "run_tool", "resource": "sql_exec",
                 "args": {"sql": {"parsed": true, "statement": ["drop"], "statement_count": 1, "has_where": true}},
                 "env": {"stage": "dev", "context_tainted": false}},
     "expect": {"decision": "DENY"}},
    {"name": "an unparseable command is never trusted",
     "request": {"actor": "bot", "action": "run_tool", "resource": "shell",
                 "args": {"shell": {"parsed": false}}, "env": {"stage": "dev", "context_tainted": false}},
     "expect": {"decision": "DENY"}},
    {"name": "rm -rf is denied",
     "request": {"actor": "bot", "action": "run_tool", "resource": "shell",
                 "args": {"shell": {"parsed": true, "rm_rf": true}}, "env": {"stage": "dev", "context_tainted": false}},
     "expect": {"decision": "DENY"}},
    {"name": "the cloud metadata address is denied",
     "request": {"actor": "bot", "action": "run_tool", "resource": "http_request",
                 "args": {"http": {"parsed": true, "scheme": "https", "host_is_private": true}},
                 "env": {"stage": "dev", "context_tainted": false}},
     "expect": {"decision": "DENY"}},
    {"name": "production needs approval",
     "request": {"actor": "bot", "action": "run_tool", "resource": "read_file",
                 "args": {"input": {"path": "/workspace/a"}}, "env": {"stage": "prod", "context_tainted": false}},
     "expect": {"decision": "REQUIRE_APPROVAL", "obligations": ["audit"]}},
    {"name": "a shell call after reading untrusted content needs approval",
     "request": {"actor": "bot", "action": "run_tool", "resource": "shell",
                 "args": {"shell": {"parsed": true, "rm_rf": false}}, "env": {"stage": "dev", "context_tainted": true}},
     "expect": {"decision": "REQUIRE_APPROVAL"}},
    {"name": "too many recent deletes stops everything",
     "request": {"actor": "bot", "action": "run_tool", "resource": "read_file",
                 "args": {"input": {"path": "/workspace/a"}}, "env": {"stage": "dev", "context_tainted": false},
                 "state": {"version": 4, "values": {"deletes_last_10m": 3}}},
     "expect": {"decision": "DENY"}},
    {"name": "a tool that is not on the list is denied by default",
     "request": {"actor": "bot", "action": "run_tool", "resource": "launch_rocket", "args": {"input": {}},
                 "env": {"stage": "dev", "context_tainted": false}},
     "expect": {"decision": "DENY", "reason_contains": "default deny"}}
  ]
}
