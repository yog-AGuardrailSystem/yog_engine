[
  {
    "name": "plain command",
    "input": {
      "command": "ls -la /tmp"
    },
    "expected": {
      "shell": {
        "parsed": true,
        "program": [
          "ls"
        ],
        "flag": [
          "-la"
        ],
        "path": [
          "/tmp"
        ],
        "arg": [
          "/tmp"
        ],
        "rm_rf": false,
        "sudo": false,
        "pipe_to_shell": false,
        "has_subshell": false,
        "has_redirect": false,
        "has_eval": false,
        "has_heredoc": false,
        "command_count": 1
      }
    }
  },
  {
    "name": "rm -rf /",
    "input": {
      "command": "rm -rf /"
