[
  {"name": "plain select", "input": {"query": "SELECT * FROM users WHERE id = 1"},
   "expected": {"sql": {"parsed": true, "statement": ["select"], "statement_count": 1, "table": ["users"], "has_where": true, "has_comment": false}}},
  {"name": "delete without where", "input": {"query": "DELETE FROM users"},
   "expected": {"sql": {"parsed": true, "statement": ["delete"], "statement_count": 1, "table": ["users"], "has_where": false, "has_comment": false}}},
  {"name": "update without where", "input": {"query": "UPDATE users SET admin = 1"},
   "expected": {"sql": {"parsed": true, "statement": ["update"], "statement_count": 1, "table": ["users"], "has_where": false, "has_comment": false}}},
  {"name": "two statements", "input": {"query": "DROP TABLE IF EXISTS users; SELECT 1"},
   "expected": {"sql": {"parsed": true, "statement": ["drop", "select"], "statement_count": 2, "table": ["users"], "has_where": true, "has_comment": false}}},
  {"name": "a dangerous statement hidden in a line comment is not a statement", "input": {"query": "SELECT 1 -- ; DROP TABLE users"},
   "expected": {"sql": {"parsed": true, "statement": ["select"], "statement_count": 1, "table": [], "has_where": true, "has_comment": true}}},
  {"name": "block comment before the statement", "input": {"query": "/* x */ DELETE FROM t WHERE 1=1"},
   "expected": {"sql": {"parsed": true, "statement": ["delete"], "statement_count": 1, "table": ["t"], "has_where": true, "has_comment": true}}},
  {"name": "a semicolon inside a string literal does not split", "input": {"query": "INSERT INTO logs (a) VALUES ('x; DROP TABLE y')"},
   "expected": {"sql": {"parsed": true, "statement": ["insert"], "statement_count": 1, "table": ["logs"], "has_where": true, "has_comment": false}}},
  {"name": "quoted schema, alias and join", "input": {"query": "select * from \"Prod\".\"Users\" u join orders o on u.id = o.uid"},
   "expected": {"sql": {"parsed": true, "statement": ["select"], "statement_count": 1, "table": ["orders", "prod.users"], "has_where": true, "has_comment": false}}},
  {"name": "comma separated from list", "input": {"query": "SELECT a FROM t1, t2 WHERE x = 1"},
   "expected": {"sql": {"parsed": true, "statement": ["select"], "statement_count": 1, "table": ["t1", "t2"], "has_where": true, "has_comment": false}}},
  {"name": "truncate", "input": {"query": "TRUNCATE TABLE audit_log"},
   "expected": {"sql": {"parsed": true, "statement": ["truncate"], "statement_count": 1, "table": ["audit_log"], "has_where": true, "has_comment": false}}},
  {"name": "a data-modifying CTE does not hide behind WITH", "input": {"query": "WITH x AS (DELETE FROM t RETURNING *) SELECT * FROM x"},
   "expected": {"sql": {"parsed": true, "statement": ["delete", "with"], "statement_count": 1, "table": ["t", "x"], "has_where": false, "has_comment": false}}},
  {"name": "unterminated string is not parsed", "input": {"query": "SELECT 'unterminated"}, "expected": {"sql": {"parsed": false}}},
  {"name": "unterminated comment is not parsed", "input": {"query": "SELECT 1 /* oops"}, "expected": {"sql": {"parsed": false}}},
  {"name": "empty is not parsed", "input": {"query": "   "}, "expected": {"sql": {"parsed": false}}},
  {"name": "missing field is not parsed", "input": {}, "expected": {"sql": {"parsed": false}}},
  {"name": "not a string is not parsed", "input": {"query": 5}, "expected": {"sql": {"parsed": false}}}
]
